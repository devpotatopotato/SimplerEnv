# setup.sh copies this file to models.env and never overwrites it.
# Replace every placeholder with an adapted checkpoint/configuration.
# train.sh updates this to the models it successfully trained. run.sh uses it
# when --models is omitted.
TRAINED_MODELS="pi05,vpp,cosmos3"

# π0.5: config registered in OpenPI; canonical Bridge/WidowX output transforms.
PI05_CONFIG_NAME="your_pi05_bridge_config"
PI05_CHECKPOINT="/path/to/pi05_bridge_checkpoint"
PI05_ADAPTATION_METHOD="action_head_or_adapter"
PI05_COMPARISON_GROUP="shared_bridge_adaptation"

# VPP: action head trained on canonical Bridge/WidowX labels.
VPP_CONFIG="/path/to/adapted_vpp_config.yaml"
VPP_VIDEO_MODEL_PATH="/path/to/svd-robot"
VPP_TEXT_ENCODER_PATH="/path/to/clip-vit-base-patch32"
VPP_ACTION_CHECKPOINT="/path/to/bridge_action_head.pt"
VPP_ADAPTATION_METHOD="frozen_video_backbone_action_head"
VPP_COMPARISON_GROUP="shared_bridge_adaptation"

# Cosmos3-Edge has a released native Bridge action domain. The Cosmos registry
# name downloads nvidia/Cosmos3-Edge on first use. Never substitute a DROID
# checkpoint: DROID produces absolute Franka joint targets.
COSMOS_CHECKPOINT="Cosmos3-Edge"
COSMOS_DOMAIN_NAME="bridge_orig_lerobot"
COSMOS_ADAPTATION_DATASET="upstream_bridge_original"
COSMOS_ADAPTATION_METHOD="native_bridge_action_head"
COSMOS_COMPARISON_GROUP="native_pretrained_bridge"
