{
  "description": "Bridge instructions corresponding to the four default SimplerEnv WidowX tasks.",
  "tasks": [
    {
      "name": "spoon_on_towel",
      "match_patterns": ["\\b(?:put|place|move|pick up)\\b.*\\bspoon\\b.*\\b(?:on|onto)\\b.*\\b(?:towel|tablecloth|table cloth)\\b"],
      "excluded_patterns": ["\\b(?:take|remove)\\b", "\\boff\\b", "\\b(?:left|right) side of\\b", "\\bbetween\\b"]
    },
    {
      "name": "carrot_on_plate",
      "match_patterns": ["\\b(?:put|place|move|pick up)\\b.*\\bcarrot\\b.*\\b(?:on|onto)\\b.*\\bplate\\b"],
      "excluded_patterns": ["\\b(?:take|remove)\\b", "\\boff\\b", "\\b(?:left|right) side of\\b", "\\bbetween\\b"]
    },
    {
      "name": "stack_cube",
      "match_patterns": ["\\b(?:put|place|move|stack)\\b.*\\bgreen (?:block|cube)\\b.*\\b(?:on|onto|above)\\b.*\\byellow (?:block|cube)\\b"]
    },
    {
      "name": "eggplant_in_basket",
      "match_patterns": ["\\b(?:put|place|move|pick up)\\b.*\\beggplant\\b.*\\b(?:in|into)\\b.*\\bbasket\\b"]
    }
  ]
}
